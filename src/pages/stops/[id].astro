---
import Base from "../../layouts/Base.astro";
import PhotoTool from "../../components/PhotoTool.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import LeadPhoto from "../../components/LeadPhoto.astro";
import Gallery from "../../components/Gallery.astro";
import PhotoViewer from "../../components/PhotoViewer.astro";
import OralHistories from "../../components/OralHistories.astro";
import { STOPS, TRAIL_NAME, stopUrl, directionsUrl, storyParagraphs, type Stop } from "../../lib/trail";
import { photosFor } from "../../lib/photos";
import InTheNews from "../../components/InTheNews.astro";
import { pressFor } from "../../lib/press";

export function getStaticPaths() {
  return STOPS.map((stop, index) => ({ params: { id: stop.id }, props: { stop, index } }));
}

interface Props { stop: Stop; index: number }
const { stop: s, index: i } = Astro.props;
const prev = STOPS[i - 1];
const next = STOPS[i + 1];
const directions = directionsUrl(s);
const { lead, events } = photosFor(s.id);
const galleries = events.filter((e) => e.photos.length);
---
<Base title={`${s.name} · ${TRAIL_NAME}`} description={s.teaser} activeId={s.id} caption={`Stop ${i + 1}: ${s.name}`}>
  <article class="stop-page" data-stop={s.id} data-index={i}>
    <a class="back" href="/#stops-h">← All {STOPS.length} stops</a>
    <p class="here" role="status" id="here"></p>
    <p class="sheet-stop">Stop {i + 1} of {STOPS.length}. {s.meta}</p>
    <h1>{s.name}</h1>
    <p class="sheet-where">{s.where}</p>
    {lead && <LeadPhoto photo={lead} eager />}
    {s.comingSoon
      ? <p class="sheet-story coming-soon">This marker's story is coming soon.</p>
      : <div class="sheet-story">{storyParagraphs(s).map((p) => <p>{p}</p>)}</div>}

    <PhotoTool id="camInput">
      {directions && <a class="btn btn-ghost" href={directions} target="_blank" rel="noopener">Get directions</a>}
      <button class="btn btn-ghost" id="visitBtn" type="button">Mark as visited</button>
      {next && <a class="btn btn-ghost" href={stopUrl(next.id)}>Next stop: {next.name}</a>}
    </PhotoTool>
    <p class="passport" aria-live="polite" data-passport>Your trail passport fills in as you visit stops.</p>

    {galleries.map((e) => <Gallery event={e} />)}

    {s.oralHistories?.length ? <OralHistories items={s.oralHistories} /> : null}

    <InTheNews items={pressFor(s.id)} compact />

    <nav class="stop-nav" aria-label="Other stops">
      {prev && <a href={stopUrl(prev.id)}><small>← Stop {i}</small><strong>{prev.name}</strong></a>}
      {next && <a href={stopUrl(next.id)}><small>Stop {i + 2} →</small><strong>{next.name}</strong></a>}
    </nav>
  </article>

  <SiteFooter />
  {galleries.length > 0 && <PhotoViewer slot="after" />}
</Base>

<script>
  import "../../scripts/stop.ts";
</script>
