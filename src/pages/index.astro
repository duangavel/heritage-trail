---
import Base from "../layouts/Base.astro";
import PhotoTool from "../components/PhotoTool.astro";
import SiteFooter from "../components/SiteFooter.astro";
import LeadPhoto from "../components/LeadPhoto.astro";
import { Image } from "astro:assets";
import { STOPS, TRAIL_NAME, stopUrl, countWord, capitalize, formatDate } from "../lib/trail";
import { photosFor, timeline, imageFor, PHOTOGRAPHER } from "../lib/photos";
import emblem from "../assets/logo/trail-emblem.png";
import SupportTrail from "../components/SupportTrail.astro";
import Testimonials from "../components/Testimonials.astro";
import intro from "../data/intro.json";
import OralHistories from "../components/OralHistories.astro";
import voicesData from "../data/voices.json";
import { checkOralHistories, type OralHistory } from "../lib/trail";

const ids = STOPS.map((s) => s.id);
const count = capitalize(countWord(STOPS.length));
const dedications = timeline();
// Oral histories about the whole trail rather than one stop; the section is hidden while empty.
const voices = voicesData as OralHistory[];
checkOralHistories(voices, "src/data/voices.json");
---
<Base title={TRAIL_NAME} description={`${count} markers across downtown and midtown Springfield, Missouri, tell the stories of the people and places that shaped Springfield and Greene County.`}>
  {/* Old-style QR links (/?stop=kentwood) go to the stop's own page. */}
  <script is:inline slot="head" define:vars={{ ids }}>
    (function () {
      var m = (location.search + location.hash).match(/stop=([a-z0-9-]+)/);
      if (m && ids.indexOf(m[1]) >= 0) location.replace("/stops/" + m[1] + "/?scan");
    })();
  </script>

  <div class="hero">
    {/* The emblem source is only ~500px wide (cut from a photo); CSS keeps it at or below 220px so the 2x image stays sharp. */}
    <Image src={emblem} alt="Springfield-Greene County African American Heritage Trail emblem." width={220} densities={[1, 2]} class="hero-emblem" loading="eager" />
    <h1>Springfield's Black history, marked where it happened.</h1>
  </div>
  <p class="lede">{count} markers across downtown and midtown tell the stories of the people and places that shaped Springfield and Greene County. Walk them in order, or start at whichever one is closest.</p>
  <div class="actions">
    <a class="btn btn-primary" href={stopUrl(STOPS[0].id)} data-open={STOPS[0].id}>Start at stop 1</a>
    <a class="btn btn-ghost" href="#photo-how">Take a trail photo</a>
  </div>
  <p class="passport" aria-live="polite" data-passport>Your trail passport fills in as you visit stops.</p>

  {/* Wording lives in src/data/intro.json. */}
  <section class="intro" aria-labelledby="intro-h">
    <h2 id="intro-h">{intro.title}</h2>
    {intro.paragraphs.map((p) => <p>{p}</p>)}
  </section>

  <h2 id="stops-h">The walk</h2>
  <p class="section-intro">Stops 1 to 11 run south to north, from the Missouri State campus up through the historic church square to Silver Springs Park and Lincoln Memorial Cemetery. Stop 12, the newest marker, is a few blocks east of Lincoln School (stop 9).</p>
  <ol class="stops" aria-labelledby="stops-h">
    {STOPS.map((s, i) => (
      <li class="stop" data-stop-id={s.id}>
        <span class="stop-num" aria-hidden="true">{i + 1}</span>
        <a class="stop-btn" href={stopUrl(s.id)} data-open={s.id}>
          <span class="stop-title">{s.name}<span data-visited-suffix={s.id}></span></span>
          <span class="stop-meta">{s.where}</span>
          <span class="stop-teaser">{s.teaser}</span>
        </a>
      </li>
    ))}
  </ol>

  <h2 id="dedications-h">Dedications</h2>
  <p class="section-intro">Each marker is unveiled in a community ceremony. <span class="photo-credit">Photos by {PHOTOGRAPHER}</span></p>
  <ol class="timeline" aria-labelledby="dedications-h">
    {dedications.map(({ stop, index, event }) => {
      const cover = event.photos[0] ?? photosFor(stop.id).lead;
      return (
        <li>
          <a href={`${stopUrl(stop.id)}#${event.id}-h`}>
            {cover && <Image src={imageFor(cover)} alt="" widths={[160, 320]} sizes="7rem" class="timeline-thumb" />}
            <span class="timeline-text">
              <time datetime={event.date}>{formatDate(event.date)}</time>
              <strong>{stop.name}</strong>
              <span>Stop {index + 1} · {event.photos.length} photos</span>
            </span>
          </a>
        </li>
      );
    })}
  </ol>

  <h2 id="photo-how">Your trail photo</h2>
  <p class="section-intro">Open any stop and choose "Take my trail photo." Snap a selfie with the marker behind you and it comes back framed with the marker's name, ready to save or share.</p>

  <h2>Scanning a marker</h2>
  <div class="qr-demo">
    <p>Each physical marker gets its own QR code. Scanning it opens this site straight to that stop, welcomes the visitor, and stamps their trail passport. Try what a visitor would see:</p>
    <div class="qr-row">
      {STOPS.slice(0, 4).map((s) => <a class="chip" href={`${stopUrl(s.id)}?scan`}>Scan: {s.name}</a>)}
    </div>
    <p class="qr-url">Each code links to the stop's own page, for example <code>/stops/{STOPS[1].id}</code>.</p>
  </div>

  {voices.length > 0 && <OralHistories items={voices} heading="Voices of the trail" idPrefix="voices" intro="Recollections of Springfield's African American community that reach across the whole trail." />}

  <Testimonials />

  <SupportTrail />

  <SiteFooter />

  <Fragment slot="after">
    <div class="scrim" id="scrim"></div>
    <section class="sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sheetTitle" aria-hidden="true">
      <button class="sheet-close" id="closeBtn" type="button" aria-label="Close">×</button>
      <p class="sheet-stop" id="sheetStop"></p>
      <h3 id="sheetTitle"></h3>
      <p class="sheet-where" id="sheetWhere"></p>
      {STOPS.map((s) => {
        const { lead, events } = photosFor(s.id);
        const gallery = events.find((e) => e.photos.length);
        const orals = s.oralHistories ?? [];
        const verb = orals.every((o) => o.type === "video") ? "Watch" : orals.every((o) => o.type === "audio") ? "Listen to" : "Watch and listen to";
        return (lead || gallery || orals.length > 0) && (
          <div data-photos-for={s.id} hidden>
            {lead && <LeadPhoto photo={lead} />}
            {gallery && <p class="sheet-gallery-link"><a href={`${stopUrl(s.id)}#${gallery.id}-h`}>See {gallery.title.toLowerCase()} photos →</a></p>}
            {orals.length > 0 && <p class="sheet-gallery-link"><a href={`${stopUrl(s.id)}#oral-h`}>{verb} {orals.length > 1 ? "the oral histories" : "the oral history"} →</a></p>}
          </div>
        );
      })}
      <div class="sheet-story" id="sheetStory"></div>
      <PhotoTool id="camInput">
        <a class="btn btn-ghost" id="dirLink" target="_blank" rel="noopener">Get directions</a>
        <button class="btn btn-ghost" id="visitBtn" type="button">Mark as visited</button>
        <a class="btn btn-ghost" id="nextBtn"></a>
      </PhotoTool>
    </section>
  </Fragment>
</Base>

<script>
  import "../scripts/home.ts";
</script>
